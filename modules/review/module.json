{
  "name": "review",
  "phase": "foundation",
  "description": "Code-review agent that blocks on the project's rules, and a commit gate bound to each worktree's staged tree, which passes small fixes over an approved tree and docs-only commits.",
  "requires": ["core"],
  "detect": { "anyOf": ["file:.git"] },
  "conflicts": [],
  "files": [
    { "from": "templates/CLAUDE.md", "to": "CLAUDE.md", "strategy": "section", "marker": "review" },
    { "from": "templates/code-review.md", "to": ".claude/agents/code-review.md", "strategy": "create" },
    { "from": "templates/shell-lexer.mjs", "to": ".claude/hooks/shell-lexer.mjs", "strategy": "create" },
    { "from": "templates/path-resolver.mjs", "to": ".claude/hooks/path-resolver.mjs", "strategy": "create" },
    { "from": "templates/commit-reader.mjs", "to": ".claude/hooks/commit-reader.mjs", "strategy": "create" },
    { "from": "templates/hook-payload.mjs", "to": ".claude/hooks/hook-payload.mjs", "strategy": "create" },
    { "from": "templates/path-glob.mjs", "to": ".claude/hooks/path-glob.mjs", "strategy": "create" },
    { "from": "templates/diff-entries.mjs", "to": ".claude/hooks/diff-entries.mjs", "strategy": "create" },
    { "from": "templates/approval-record.mjs", "to": ".claude/hooks/approval-record.mjs", "strategy": "create" },
    { "from": "templates/review-config.mjs", "to": ".claude/hooks/review-config.mjs", "strategy": "create" },
    { "from": "templates/review-exemptions.mjs", "to": ".claude/hooks/review-exemptions.mjs", "strategy": "create" },
    { "from": "templates/git-state.mjs", "to": ".claude/hooks/git-state.mjs", "strategy": "create" },
    { "from": "templates/worktree-scope.mjs", "to": ".claude/hooks/worktree-scope.mjs", "strategy": "create" },
    { "from": "templates/review-gate.mjs", "to": ".claude/hooks/review-gate.mjs", "strategy": "create" },
    { "from": "templates/require-review.mjs", "to": ".claude/hooks/require-review.mjs", "strategy": "create" },
    { "from": "templates/approve-review.mjs", "to": ".claude/hooks/approve-review.mjs", "strategy": "create" },
    { "from": "templates/review.json", "to": ".claude/review.json", "strategy": "create" },
    {
      "from": "templates/settings.json",
      "to": ".claude/settings.json",
      "strategy": "merge-json",
      "ownedArrays": { "hooks.PreToolUse": "require-review.mjs" }
    }
  ]
}
